<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net9.0-windows</TargetFramework>
        <PlatformTarget>x64</PlatformTarget>
        <LangVersion>preview</LangVersion>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <UseWPF>true</UseWPF>
        <EnableUnsafeBinaryFormatterSerialization>false</EnableUnsafeBinaryFormatterSerialization>
        <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
        <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
        <GenerateSatelliteAssembliesForCore>false</GenerateSatelliteAssembliesForCore>
        <ApplicationIcon>Resources\Ox.ico</ApplicationIcon>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <Title>Video Converter 0x</Title>
        <Authors>0xniel FT Azalea2n</Authors>
        <NeutralLanguage>id-ID</NeutralLanguage>
        <Description>Aplikasi konversi video yang ringan dan mudah digunakan, mendukung berbagai format video populer dengan kualitas tinggi.</Description>
        <Copyright> 2025 0xniel FT Azalea2n. All rights reserved.</Copyright>
        <PackageTags>video converter, ffmpeg, video tools, mp4, avi, mkv, mov, wmv</PackageTags>
        <PackageReleaseNotes>Rilis Awal (v1.0.0):
        - Fitur konversi video ke berbagai format (MP4, AVI, MKV, MOV, WMV)
        - Dukungan kualitas video yang dapat disesuaikan
        - Antarmuka pengguna yang ramah dan mudah digunakan
        - Dukungan drag and drop untuk file video
        - Tampilan progress konversi yang informatif</PackageReleaseNotes>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageIcon>Ox.png</PackageIcon>
        <RepositoryUrl>https://github.com/Azalea2n/OxVidco</RepositoryUrl>
        <Company>0xCo</Company>
        <AssemblyVersion>1.0.0.0</AssemblyVersion>
        <FileVersion>1.0.0.0</FileVersion>
        <SignAssembly>true</SignAssembly>
        <AssemblyOriginatorKeyFile>oxvidco.snk</AssemblyOriginatorKeyFile>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
        <DebugType>portable</DebugType>
        <DebugSymbols>true</DebugSymbols>
    </PropertyGroup>

    <!-- Tambahkan konfigurasi untuk Release -->
    <PropertyGroup Condition="'$(Configuration)' == 'Release'">
        <DebugType>none</DebugType>
        <DebugSymbols>false</DebugSymbols>
        <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    </PropertyGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.WindowsDesktop.App.WindowsForms" />
        <None Include="Ox.png">
            <Pack>True</Pack>
            <PackagePath>\</PackagePath>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <None Include="README.md" Pack="true" PackagePath="\">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <PackageReference Include="FFmpeg.AutoGen" Version="7.1.1" />
        <PackageReference Include="HtmlAgilityPack" Version="1.12.2" />
        <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    </ItemGroup>

    <ItemGroup>
      <Folder Include="Installer\" />
      <Folder Include="Resources\Images\" />
      <Folder Include="Themes\" />
    </ItemGroup>

    <ItemGroup>
      <Page Update="Resources\Icons.xaml">
        <Generator>MSBuild:Compile</Generator>
      </Page>
      <Page Update="MainWindow.xaml">
        <Generator>MSBuild:Compile</Generator>
      </Page>
    </ItemGroup>

    <ItemGroup>
      <Content Update="Resources\Ox.ico">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
      <None Remove="Resources\Ox.png" />
      <Content Update="Ox.png">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
    </ItemGroup>

    <Target Name="CopyFFmpeg" AfterTargets="Build">
      <ItemGroup>
        <FFmpegFiles Include="$(ProjectDir)ffmpeg\**\*" />
      </ItemGroup>
      <Copy SourceFiles="@(FFmpegFiles)" 
            DestinationFiles="@(FFmpegFiles->'$(OutDir)%(RecursiveDir)%(Filename)%(Extension)')" 
            SkipUnchangedFiles="true" />
    </Target>

</Project>
