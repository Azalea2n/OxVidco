<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net9.0-windows</TargetFramework>
        <PlatformTarget>x64</PlatformTarget>
        <LangVersion>preview</LangVersion>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <UseWPF>true</UseWPF>
        <EnableUnsafeBinaryFormatterSerialization>false</EnableUnsafeBinaryFormatterSerialization>
        <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
        <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
        <GenerateSatelliteAssembliesForCore>false</GenerateSatelliteAssembliesForCore>
        <ApplicationIcon>Resources\Ox.ico</ApplicationIcon>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <Title>Video Converter 0x</Title>
        <Authors>0xniel FT Azalea2n</Authors>
        <NeutralLanguage>id-ID</NeutralLanguage>
        <Description>Aplikasi konversi video yang ringan dan mudah digunakan, mendukung berbagai format video populer dengan kualitas tinggi.</Description>
        <Copyright> 2025 0xniel FT Azalea2n. All rights reserved.</Copyright>
        <PackageTags>video converter, ffmpeg, video tools, mp4, avi, mkv, mov, wmv</PackageTags>
        <PackageReleaseNotes>Rilis Awal (v1.0.0):
        - Fitur konversi video ke berbagai format (MP4, AVI, MKV, MOV, WMV)
        - Dukungan kualitas video yang dapat disesuaikan
        - Antarmuka pengguna yang ramah dan mudah digunakan
        - Dukungan drag and drop untuk file video
        - Tampilan progress konversi yang informatif
        
Rilis v1.0.1:
        - Perbaikan sistem pembaruan otomatis
        - Perbaikan dependensi eksternal
        
Rilis v1.0.2:
        - Pembaruan versi proyek

Rilis v1.1.0:
        - Penambahan dukungan format video tambahan (WebM, FLV, M4V, 3GP)
        - Perbaikan manajemen file FFmpeg
        - Penyempurnaan antarmuka pengguna
        - Peningkatan sistem pembaruan</PackageReleaseNotes>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageIcon>Ox.png</PackageIcon>
        <Version>1.1.0</Version>
        <RepositoryUrl>https://github.com/Azalea2n/OxVidco</RepositoryUrl>
        <Company>0xCo</Company>
        <AssemblyVersion>1.1.0.0</AssemblyVersion>
        <FileVersion>1.1.0.0</FileVersion>
        <SignAssembly>true</SignAssembly>
        <AssemblyOriginatorKeyFile>oxvidco.snk</AssemblyOriginatorKeyFile>
        <Platforms>AnyCPU;x64</Platforms>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
        <DebugType>portable</DebugType>
        <DebugSymbols>true</DebugSymbols>
    </PropertyGroup>

    <!-- Tambahkan konfigurasi untuk Release -->
    <PropertyGroup Condition="'$(Configuration)' == 'Release'">
        <DebugType>none</DebugType>
        <DebugSymbols>false</DebugSymbols>
        <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    </PropertyGroup>
    <ItemGroup>
      <Compile Remove="Installer\**" />
      <Compile Remove="Output\**" />
      <Compile Remove="Themes\**" />
      <EmbeddedResource Remove="Installer\**" />
      <EmbeddedResource Remove="Output\**" />
      <EmbeddedResource Remove="Themes\**" />
      <None Remove="Installer\**" />
      <None Remove="Output\**" />
      <None Remove="Themes\**" />
      <Page Remove="Installer\**" />
      <Page Remove="Output\**" />
      <Page Remove="Themes\**" />
    </ItemGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.WindowsDesktop.App.WindowsForms" />
        <None Include="bin\Release\net9.0-windows\Ox.ico" />
        <None Include="Ox.png" Pack="true" PackagePath="" />
        <None Include="README.md" Pack="true" PackagePath="\">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <PackageReference Include="FFmpeg.AutoGen" Version="7.1.1" />
        <PackageReference Include="HtmlAgilityPack" Version="1.12.2" />
        <PackageReference Include="Newtonsoft.Json" Version="13.0.3" PrivateAssets="all" />
    </ItemGroup>

    <ItemGroup>
      <Folder Include="Resources\Images\" />
    </ItemGroup>

    <ItemGroup>
      <Page Update="Resources\Icons.xaml">
        <Generator>MSBuild:Compile</Generator>
      </Page>
      <Page Update="MainWindow.xaml">
        <Generator>MSBuild:Compile</Generator>
      </Page>
    </ItemGroup>

    <ItemGroup>
      <Content Update="Resources\Ox.ico">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
      <None Remove="C.jpeg" />
      <None Remove="Resources\Ox.png" />
      <Content Include="update.json">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
    </ItemGroup>

    <ItemGroup>
      <Resource Include="C.jpeg" />
      <Resource Include="Ox.png" />
    </ItemGroup>

    <!-- Hapus folder x64 yang tidak diperlukan -->
    <Target Name="CleanDuplicateFFmpeg" AfterTargets="Build">
        <Message Importance="high" Text="Membersihkan duplikasi file FFmpeg..." />
        <RemoveDir Directories="$(OutDir)x64" />
    </Target>

    <Target Name="CopyFFmpeg" AfterTargets="Build">
        <Message Importance="high" Text="Menyalin file FFmpeg..." />
        
        <!-- Pastikan direktori tujuan ada -->
        <MakeDir Directories="$(OutDir)ffmpeg\x64" />
        
        <!-- Salin file-file FFmpeg -->
        <Copy SourceFiles="$(ProjectDir)ffmpeg\x64\ffmpeg.exe" DestinationFolder="$(OutDir)ffmpeg\x64" SkipUnchangedFiles="true" OverwriteReadOnlyFiles="true" Retries="3" RetryDelayMilliseconds="1000" />
              
        <!-- Hanya salin ffplay.exe jika ada di direktori sumber -->
        <Copy SourceFiles="$(ProjectDir)ffmpeg\x64\ffplay.exe" DestinationFolder="$(OutDir)ffmpeg\x64" SkipUnchangedFiles="true" OverwriteReadOnlyFiles="true" Retries="3" RetryDelayMilliseconds="1000" Condition="Exists('$(ProjectDir)ffmpeg\x64\ffplay.exe')" />
              
        <Copy SourceFiles="$(ProjectDir)ffmpeg\x64\ffprobe.exe" DestinationFolder="$(OutDir)ffmpeg\x64" SkipUnchangedFiles="true" OverwriteReadOnlyFiles="true" Retries="3" RetryDelayMilliseconds="1000" />
              
        <Message Importance="high" Text="File FFmpeg berhasil disalin ke: $(OutDir)ffmpeg\x64\" />
    </Target>

    <Target Name="CopyNewtonsoftJson" AfterTargets="Build">
        <ItemGroup>
            <NewtonsoftJsonFile Include="$(UserProfile)\.nuget\packages\newtonsoft.json\13.0.3\lib\**\Newtonsoft.Json.dll" />
        </ItemGroup>
        <Copy SourceFiles="@(NewtonsoftJsonFile)" DestinationFolder="$(OutDir)" />
    </Target>

    <Target Name="CopyHtmlAgilityPack" AfterTargets="Build">
        <ItemGroup>
            <HtmlAgilityPackFile Include="$(UserProfile)\.nuget\packages\htmlagilitypack\1.12.2\lib\netstandard2.0\HtmlAgilityPack.dll" />
        </ItemGroup>
        <Copy SourceFiles="@(HtmlAgilityPackFile)" DestinationFolder="$(OutDir)" />
    </Target>

</Project>