<Window x:Class="OxVidco.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:OxVidco.Models"
        mc:Ignorable="d"
        Title="OxVidco - Video Converter" 
        Height="600" 
        Width="900"
        MinHeight="500"
        MinWidth="800"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5"
        FontFamily="Segoe UI"
        TextElement.Foreground="#333333">
    
    <Window.Resources>
        <!-- Efek Shadow untuk Card -->
        <DropShadowEffect x:Key="CardShadow" 
                         BlurRadius="10" 
                         Color="#40000000" 
                         Direction="270" 
                         Opacity="0.1" 
                         ShadowDepth="2"/>
        
        <!-- Style untuk Card -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
            <Setter Property="Effect" Value="{StaticResource CardShadow}"/>
        </Style>
        
        <!-- Template untuk FeatureCard -->
    </Window.Resources>
    
    <TabControl>
        <!-- Tab Konversi Video -->
        <TabItem Header="Konversi Video">
            <Grid Margin="5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="OxVidco" 
                  FontSize="24" FontWeight="Bold" 
                  Margin="0,0,0,20"
                  HorizontalAlignment="Center"/>

        <!-- File List -->
        <GroupBox Grid.Row="1" Header="Daftar Video" Margin="0,0,0,10">
            <Grid>
                <ListView x:Name="VideoList" Margin="5">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Nama File" Width="300" DisplayMemberBinding="{Binding FileName}"/>
                            <GridViewColumn Header="Ukuran" Width="100" DisplayMemberBinding="{Binding FileSize, StringFormat={}{0} MB}"/>
                            <GridViewColumn Header="Format" Width="80" DisplayMemberBinding="{Binding FileExtension}"/>
                            <GridViewColumn Header="Status" Width="100" DisplayMemberBinding="{Binding Status}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Grid>
        </GroupBox>

        <!-- Output Settings -->
        <GroupBox Grid.Row="2" Header="Pengaturan Output" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Label Grid.Row="0" Grid.Column="0" Content="Format Output:" Margin="5"/>
                <ComboBox x:Name="OutputFormatComboBox" Grid.Row="0" Grid.Column="1" Margin="5" Width="150" HorizontalAlignment="Left">
                    <ComboBoxItem Content="MP4" IsSelected="True"/>
                    <ComboBoxItem Content="AVI"/>
                    <ComboBoxItem Content="MKV"/>
                    <ComboBoxItem Content="MOV"/>
                    <ComboBoxItem Content="WMV"/>
                </ComboBox>

                <Label Grid.Row="0" Grid.Column="2" Content="Kualitas Video:" Margin="5"/>
                <ComboBox x:Name="QualityComboBox" Grid.Row="0" Grid.Column="3" Margin="5" Width="150" HorizontalAlignment="Left">
                    <ComboBoxItem Content="Tinggi (HD)" IsSelected="True"/>
                    <ComboBoxItem Content="Standar (SD)"/>
                    <ComboBoxItem Content="Rendah (Mobile)"/>
                </ComboBox>

                <Label Grid.Row="1" Grid.Column="0" Content="Folder Tujuan:" Margin="5"/>
                <TextBox x:Name="OutputFolderTextBox" Grid.Row="1" Grid.Column="1" Margin="5" IsReadOnly="True"/>
                <Button x:Name="BrowseFolderButton" Grid.Row="1" Grid.Column="2" Content="Pilih Folder..." Margin="5,0" Padding="10,2" Click="BrowseFolderButton_Click"/>
            </Grid>
        </GroupBox>

        <!-- Progress -->
        <Grid Grid.Row="3" Margin="0,0,0,10">
            <ProgressBar x:Name="ConversionProgress" Height="20" Minimum="0" Maximum="100" Value="0"/>
            <TextBlock x:Name="StatusText" Text="Siap" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="AddFilesButton" Content="Tambah File" Margin="0,0,10,0" Padding="15,5" Click="AddFilesButton_Click"/>
            <Button x:Name="ConvertButton" Content="Konversi" Margin="0,0,10,0" Padding="15,5" Click="ConvertButton_Click"/>
            <Button x:Name="CancelButton" Content="Batal" Margin="0,0,10,0" Padding="15,5" Click="CancelButton_Click" IsEnabled="False"/>
            <Button x:Name="ClearButton" Content="Bersihkan" Padding="15,5" Click="ClearButton_Click"/>
        </StackPanel>
            </Grid>
        </TabItem>
        
        <!-- Tab Tentang -->
        <TabItem Header="Tentang">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Header dengan Logo -->
                    <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,30">
                        <TextBlock Text="OXVIDCO" 
                                 FontSize="32" 
                                 FontWeight="SemiBold"
                                 Foreground="#2196F3"
                                 HorizontalAlignment="Center"/>
                        <TextBlock Text="Video Converter" 
                                 FontSize="14" 
                                 Foreground="#666"
                                 HorizontalAlignment="Center"/>
                        <TextBlock Text="v1.0.0" 
                                 FontSize="12" 
                                 Foreground="#999"
                                 HorizontalAlignment="Center"
                                 Margin="0,5,0,0"/>
                    </StackPanel>

                    <!-- Fitur Utama -->
                    <Border Grid.Row="1" 
                            BorderBrush="#E0E0E0" 
                            BorderThickness="0 0 0 1" 
                            Padding="0,0,0,20"
                            Margin="0,0,0,20">
                        <ItemsControl ItemsSource="{Binding FeatureCards}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="models:FeatureCard">
                                    <Border Style="{StaticResource CardStyle}" Width="280" Height="140" Margin="10">
                                        <StackPanel Margin="15">
                                            <TextBlock Text="{Binding Icon}" 
                                                     FontSize="28" 
                                                     Margin="0,0,0,10"/>
                                            <TextBlock Text="{Binding Title}" 
                                                     FontSize="16" 
                                                     FontWeight="SemiBold"
                                                     Margin="0,0,0,5"/>
                                            <TextBlock Text="{Binding Description}" 
                                                     TextWrapping="Wrap"
                                                     Foreground="#666"
                                                     FontSize="13"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel HorizontalAlignment="Center"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </Border>

                    <!-- Informasi Tambahan -->
                    <StackPanel Grid.Row="2" Margin="0,0,0,30">
                        <TextBlock Text="Tentang Aplikasi" 
                                 FontSize="18" 
                                 FontWeight="SemiBold"
                                 Margin="0,0,0,15"/>
                        <TextBlock TextWrapping="Wrap" TextAlignment="Justify" Margin="0,0,0,20">
                            OxVidco adalah aplikasi konversi video profesional yang dirancang untuk memberikan pengalaman konversi video yang mudah, cepat, dan berkualitas tinggi. 
                            Dengan antarmuka yang intuitif dan fitur yang lengkap, aplikasi ini cocok untuk berbagai kebutuhan konversi video Anda.
                        </TextBlock>
                        
                    </StackPanel>

                    <!-- Footer -->
                    <Border Grid.Row="3" 
                            BorderBrush="#E0E0E0" 
                            BorderThickness="0 1 0 0" 
                            Padding="0,15,0,5">
                        <StackPanel>
                            <TextBlock Text="© 2025 OxVidco. All rights reserved." 
                                     HorizontalAlignment="Center" 
                                     Foreground="#777"
                                     FontSize="12"/>
                            <TextBlock Text="Dibuat Oleh Oxniel" 
                                     HorizontalAlignment="Center" 
                                     Foreground="#999"
                                     FontSize="11"
                                     Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </ScrollViewer>
        </TabItem>

        <!-- Tab Bantuan -->
        <TabItem Header="Bantuan">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,20">
                        <TextBlock Text="📚 Panduan Penggunaan OxVidco" 
                                 FontSize="24" 
                                 FontWeight="SemiBold"
                                 Foreground="#2196F3"/>
                        <TextBlock Text="Temukan panduan lengkap untuk menggunakan aplikasi konversi video dengan mudah"
                                 FontSize="14"
                                 Foreground="#666"
                                 Margin="0,5,0,0"/>
                    </StackPanel>

                    <!-- Kategori Bantuan -->
                    <TabControl Grid.Row="1" 
                               BorderThickness="0"
                               Background="Transparent"
                               Padding="0"
                               Margin="0,10,0,0">
                        <TabControl.Resources>
                            <Style TargetType="TabItem">
                                <Setter Property="Padding" Value="16,12"/>
                                <Setter Property="FontSize" Value="14"/>
                                <Setter Property="Foreground" Value="#5F6368"/>
                                <Setter Property="BorderThickness" Value="0 0 0 3"/>
                                <Setter Property="BorderBrush" Value="Transparent"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Margin" Value="0,0,2,0"/>
                                <Setter Property="FontFamily" Value="Segoe UI, sans-serif"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Foreground" Value="#1A73E8"/>
                                        <Setter Property="BorderBrush" Value="#1A73E8"/>
                                        <Setter Property="FontWeight" Value="600"/>
                                        <Setter Property="Background" Value="#F1F3F4"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#F1F3F4"/>
                                        <Setter Property="Foreground" Value="#1A73E8"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TabControl.Resources>

                        <!-- Panduan Dasar -->
                        <TabItem Header="Panduan Dasar">
                            <Border Background="#FFFFFF" 
                                    BorderBrush="#DADCE0" 
                                    BorderThickness="0 1px 0 0"
                                    Padding="16">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" 
                                              Padding="0 8px">
                                    <ItemsControl ItemsSource="{Binding BasicHelpItems}" 
                                                ItemContainerStyle="{StaticResource CardItemStyle}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="models:HelpItem">
                                                <Border Style="{StaticResource CardStyle}">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="*"/>
                                                        </Grid.RowDefinitions>
                                                        <Border Background="#E3F2FD" 
                                                                Padding="16"
                                                                CornerRadius="8 8 0 0">
                                                            <DockPanel>
                                                                <Border Background="#BBDEFB" 
                                                                        Width="36" 
                                                                        Height="36" 
                                                                        CornerRadius="18"
                                                                        VerticalAlignment="Center"
                                                                        Margin="0,0,12,0">
                                                                    <TextBlock Text="📘" 
                                                                             FontSize="20"
                                                                             HorizontalAlignment="Center"
                                                                             VerticalAlignment="Center"/>
                                                                </Border>
                                                                <TextBlock Text="{Binding Title}" 
                                                                         FontWeight="600"
                                                                         FontSize="15"
                                                                         VerticalAlignment="Center"
                                                                         Foreground="#0D47A1"/>
                                                            </DockPanel>
                                                        </Border>
                                                        <Border Grid.Row="1"
                                                                Background="#FFFFFF"
                                                                Padding="16"
                                                                CornerRadius="0 0 8 8">
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding Description}" 
                                                                         TextWrapping="Wrap"
                                                                         Foreground="#5F6368"
                                                                         FontSize="14"
                                                                         LineHeight="22"
                                                                         Margin="0,0,0,16"/>
                                                                
                                                                <TextBlock Text="Langkah-langkah" 
                                                                         FontWeight="600"
                                                                         FontSize="14"
                                                                         Foreground="#0D47A1"
                                                                         Margin="0,0,0,8"/>
                                                                
                                                                <ItemsControl ItemsSource="{Binding Steps}" 
                                                                            Margin="8,0,0,16">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <Grid Margin="0,8,0,0">
                                                                                <Grid.ColumnDefinitions>
                                                                                    <ColumnDefinition Width="Auto"/>
                                                                                    <ColumnDefinition Width="*"/>
                                                                                </Grid.ColumnDefinitions>
                                                                                <Border Width="24"
                                                                                        Height="24"
                                                                                        Background="#E3F2FD"
                                                                                        CornerRadius="12"
                                                                                        VerticalAlignment="Top"
                                                                                        Margin="0,2,12,0">
                                                                                    <TextBlock Text="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ContentPresenter}, 
                                                                                                         Converter={StaticResource IndexInItemsControl}}" 
                                                                                              HorizontalAlignment="Center"
                                                                                              VerticalAlignment="Center"
                                                                                              FontWeight="600"
                                                                                              Foreground="#0D47A1"/>
                                                                                </Border>
                                                                                <TextBlock Text="{Binding}" 
                                                                                         Grid.Column="1"
                                                                                         TextWrapping="Wrap"
                                                                                         Foreground="#5F6368"
                                                                                         FontSize="14"
                                                                                         LineHeight="22"/>
                                                                            </Grid>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                                
                                                                <Image Source="{Binding ImagePath}" 
                                                                       Width="Auto"
                                                                       MaxWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ScrollContentPresenter}}"
                                                                       Margin="0,8,0,0"
                                                                       HorizontalAlignment="Left"
                                                                       Visibility="{Binding ImagePath, Converter={StaticResource NullToVisibilityConverter}}"
                                                                       Style="{StaticResource RoundedImageStyle}"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>
                        </TabItem>

                        <!-- Tips & Trik -->
                        <TabItem Header="Tips &amp; Trik">
                            <Border Background="#FFFFFF" 
                                    BorderBrush="#DADCE0" 
                                    BorderThickness="0 1px 0 0"
                                    Padding="16">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" 
                                              Padding="0 8px">
                                    <ItemsControl ItemsSource="{Binding TipsItems}" 
                                                ItemContainerStyle="{StaticResource CardItemStyle}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="models:HelpItem">
                                                <Border Style="{StaticResource CardStyle}">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="*"/>
                                                        </Grid.RowDefinitions>
                                                        <Border Background="#E8F5E9" 
                                                                Padding="16"
                                                                CornerRadius="8 8 0 0">
                                                            <DockPanel>
                                                                <Border Background="#C8E6C9" 
                                                                        Width="36" 
                                                                        Height="36" 
                                                                        CornerRadius="18"
                                                                        VerticalAlignment="Center"
                                                                        Margin="0,0,12,0">
                                                                    <TextBlock Text="💡" 
                                                                             FontSize="20"
                                                                             HorizontalAlignment="Center"
                                                                             VerticalAlignment="Center"/>
                                                                </Border>
                                                                <TextBlock Text="{Binding Title}" 
                                                                         FontWeight="600"
                                                                         FontSize="15"
                                                                         VerticalAlignment="Center"
                                                                         Foreground="#1E8E3E"/>
                                                            </DockPanel>
                                                        </Border>
                                                        <Border Grid.Row="1"
                                                                Background="#FFFFFF"
                                                                Padding="16"
                                                                CornerRadius="0 0 8 8">
                                                            <TextBlock Text="{Binding Description}" 
                                                                     TextWrapping="Wrap"
                                                                     Foreground="#5F6368"
                                                                     FontSize="14"
                                                                     LineHeight="22"/>
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>
                        </TabItem>

                        <!-- Pertanyaan Umum -->
                        <TabItem Header="Pertanyaan Umum">
                            <Border Background="#FFFFFF" 
                                    BorderBrush="#DADCE0" 
                                    BorderThickness="0 1px 0 0"
                                    Padding="16">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" 
                                              Padding="0 8px">
                                    <ItemsControl ItemsSource="{Binding FaqItems}" 
                                                ItemContainerStyle="{StaticResource CardItemStyle}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="models:FAQItem">
                                                <Border Style="{StaticResource CardStyle}">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="*"/>
                                                        </Grid.RowDefinitions>
                                                        <Border Background="#E6F4EA" 
                                                                Padding="16"
                                                                CornerRadius="8 8 0 0">
                                                            <DockPanel>
                                                                <Border Background="#A8DAB5" 
                                                                        Width="36" 
                                                                        Height="36" 
                                                                        CornerRadius="18"
                                                                        VerticalAlignment="Center"
                                                                        Margin="0,0,12,0">
                                                                    <TextBlock Text="❓" 
                                                                             FontSize="20"
                                                                             HorizontalAlignment="Center"
                                                                             VerticalAlignment="Center"/>
                                                                </Border>
                                                                <TextBlock Text="{Binding Question}" 
                                                                         FontWeight="600"
                                                                         FontSize="15"
                                                                         VerticalAlignment="Center"
                                                                         Foreground="#0D653E"
                                                                         TextWrapping="Wrap"/>
                                                            </DockPanel>
                                                        </Border>
                                                        <Border Grid.Row="1"
                                                                Background="#FFFFFF"
                                                                Padding="16"
                                                                CornerRadius="0 0 8 8">
                                                            <TextBlock Text="{Binding Answer}" 
                                                                     TextWrapping="Wrap"
                                                                     Foreground="#5F6368"
                                                                     FontSize="14"
                                                                     LineHeight="22"/>
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>
                        </TabItem>
                    </TabControl>
                </Grid>
            </ScrollViewer>
        </TabItem>
    </TabControl>
</Window>
