<UserControl x:Class="OxVidco.Views.UpdateView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="500" d:DesignWidth="800">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,24">
            <TextBlock Text="Pembaruan"
                       FontSize="24"
                       FontWeight="SemiBold"
                       Foreground="#333333" />
            <TextBlock Text="Periksa pembaruan terbaru untuk OxVidco"
                       FontSize="14"
                       Foreground="#666666"
                       Margin="0,4,0,0" />
        </StackPanel>

        <Border Grid.Row="1"
                BorderBrush="#E0E0E0"
                BorderThickness="1"
                CornerRadius="4"
                Padding="24"
                Background="#FFFFFF">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10"
                                  Color="#40000000"
                                  Direction="270"
                                  Opacity="0.1"
                                  ShadowDepth="2" />
            </Border.Effect>
            <Grid>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                            Width="NaN" Height="NaN" >

                    <TextBlock Text="{Binding StatusMessage}"
                               FontSize="16"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               Foreground="#333333"
                               Margin="0,0,0,24" />

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Margin="0,8">

                        <Button
                            Command="{Binding CheckForUpdatesCommand, Mode=OneWay}"
                            CommandParameter="{Binding}"
                            IsEnabled="{Binding CanCheckForUpdates}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Margin="0,0,12,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🔄" Margin="0,0,8,0" />
                                <TextBlock Text="Periksa Pembaruan" />
                            </StackPanel>
                        </Button>

                        <Button
                            Command="{Binding DownloadUpdateCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Margin="12,0,0,0"
                            Visibility="{Binding HasUpdate, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⬇️" Margin="0,0,8,0" />
                                <TextBlock Text="Unduh Pembaruan" />
                            </StackPanel>
                        </Button>

                        <ProgressBar
                            Width="20"
                            Height="24"
                            IsIndeterminate="True"
                            Foreground="#2196F3"
                            Background="#E3F2FD"
                            BorderThickness="0"
                            Margin="12,0,8,0"
                            Visibility="{Binding IsCheckingForUpdates, Converter={StaticResource BooleanToVisibilityConverter}}" />

                        <TextBlock
                            Text="Memeriksa pembaruan..."
                            VerticalAlignment="Center"
                            Foreground="#666666"
                            Visibility="{Binding IsCheckingForUpdates, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </StackPanel>

                    <Border Background="#FFFFFF"
                            CornerRadius="4"
                            Padding="16"
                            Margin="0,16,0,0"
                            BorderThickness="1"
                            BorderBrush="#E0E0E0"
                            Visibility="{Binding HasUpdate, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <TextBlock Text="Catatan Rilis"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="#333333"
                                       Margin="0,0,0,8" />

                            <ScrollViewer Grid.Row="1"
                                          VerticalScrollBarVisibility="Auto"
                                          MaxHeight="200"
                                          Padding="0,8,0,0">
                                <TextBlock Text="{Binding UpdateInfo.Changelog}"
                                           FontSize="14"
                                           Foreground="#666666"
                                           TextWrapping="Wrap" />
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Margin="24,24,0,0">
                        <StackPanel.Resources>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontSize" Value="13" />
                                <Setter Property="Foreground" Value="#666666" />
                                <Setter Property="Margin" Value="0,0,16,0" />
                            </Style>
                        </StackPanel.Resources>

                        <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                            <TextBlock Text="Versi saat ini: " />
                            <TextBlock Text="{Binding CurrentVersion, Mode=OneWay}"
                                       FontWeight="SemiBold"
                                       Foreground="#333333" />
                        </StackPanel>

                        <Rectangle Width="1"
                                   Height="12"
                                   Fill="#E0E0E0"
                                   VerticalAlignment="Center"
                                   Margin="0,0,16,0" />

                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Versi terbaru: " />
                            <TextBlock Text="{Binding UpdateInfo.Version, Mode=OneWay, FallbackValue='-'}"
                                       FontWeight="SemiBold"
                                       Foreground="{Binding HasUpdate, Converter={StaticResource BoolToColorConverter}, ConverterParameter='#4CAF50|#2196F3'}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>

